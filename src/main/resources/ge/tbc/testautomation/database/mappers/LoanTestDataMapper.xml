<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ge.tbc.testautomation.database.mappers.LoanTestDataMapper">

    <resultMap id="LoanTestDataMap" type="ge.tbc.testautomation.database.models.LoanTestData">
        <id property="id" column="id"/>
        <result property="description" column="description"/>
        <result property="loanAmount" column="loan_amount"/>
        <result property="loanTermMonths" column="loan_term_months"/>
    </resultMap>

    <select id="getAllLoanTestData" resultMap="LoanTestDataMap">
        SELECT id, description, loan_amount, loan_term_months
        FROM loan_test_data
    </select>

</mapper>