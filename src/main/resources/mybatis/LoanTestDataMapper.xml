<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="ge.tbc.testautomation.database.mappers.LoanTestDataMapper">

    <select id="getAllLoanTestData"
            resultType="ge.tbc.testautomation.database.models.LoanTestData">

        SELECT
        id,
        description,
        loan_amount AS loanAmount,
        loan_term_months AS loanTermMonths
        FROM loan_test_data
        ORDER BY id

    </select>

</mapper>